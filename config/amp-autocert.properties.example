# Public, NON-SECRET configuration. Never put API tokens in this file.
# Copy into the Minecraft SERVER directory: automodpack/amp-autocert.properties
# Keep disabled and staging until dedicated-server and separate test-zone checks are complete.
enabled=false
debugmode=false
acme.environment=staging
acme.email=admin@mydomain.com
origin.hostname=play.mydomain.com
cloudflare.zoneName=mydomain.com
cloudflare.zoneId=REPLACE_WITH_YOUR_CLOUDFLARE_ZONE_ID

# Bounded network and DNS behavior.
acme.networkTimeoutSeconds=30
dns.propagationTimeoutSeconds=120
dns.propagationInitialDelaySeconds=15
cloudflare.ttlSeconds=60

# Renewal, retry, and lightweight local drift polling.
renew.beforeDays=30
check.intervalHours=24
drift.pollSeconds=60
renew.failureCooldownHours=48
retry.initialMinutes=15
retry.maxHours=12
retry.jitterPercent=20

host.restartAfterRenew=true
host.activationTimeoutSeconds=60
host.readinessPollSeconds=1

# Pterodactyl compatibility fallbacks. Prefer false whenever permissions can be enforced.
credentials.allowInsecureTokenFilePermissions=false
credentials.allowInsecureDeploymentFilePermissions=false
