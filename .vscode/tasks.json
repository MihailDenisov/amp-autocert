{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Gradle: build",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew",
      "windows": { "command": "${workspaceFolder}\\gradlew.bat" },
      "args": ["build"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Gradle: test",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew",
      "windows": { "command": "${workspaceFolder}\\gradlew.bat" },
      "args": ["test"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Gradle: runServer",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew",
      "windows": { "command": "${workspaceFolder}\\gradlew.bat" },
      "args": ["runServer"],
      "problemMatcher": []
    }
  ]
}
